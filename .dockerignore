# ==============================================================================
# BROSAN TEKSTİL ERP — PRODUCTION DOCKERIGNORE
# Prevents sensitive credentials, caches, docs and test artifacts from leaking
# into the Docker build context or runtime image.
# ==============================================================================

# Dependencies & Build artifacts
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm

# Version Control & Agent metadata
.git
.gitignore
.agents
.gemini

# Sensitive Environment & Key files
.env
.env.*
*.key
*.pem
*.cert
*.crt

# Local Databases, Logs & Temporary Dumps
*.log
*.sqlite
*.db
*.sql
*.bak

# Documents, Exports & Media Assets (Not needed in web runner)
*.pdf
*.xlsx
*.jpg
*.png
*.zip
*.tar.gz
ETGB_DOSYALARI
RESMI_ETGB_BEYANNAMELERI
extracted_stamps
IBKB_FORMLAR

# Test Suites (Run outside container during CI/CD)
tests

# Python scripts and virtual environments
__pycache__
*.pyc
*.py
