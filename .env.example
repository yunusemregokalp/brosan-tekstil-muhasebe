# ==============================================================================
# BROSAN TEKSTİL ERP — ORTAM DEĞİŞKENLERİ ŞABLONU (.env.example)
# ==============================================================================

# Sunucu Port ve Çalışma Ortamı
PORT=3000
NODE_ENV=production
APP_NAME="Brosan Tekstil ERP"

# PostgreSQL Veritabanı Bağlantısı
# Coolify Docker Compose içinde 'postgres' servis adına bağlanır:
# postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=BrosanTekstil2026SecurePass!
POSTGRES_DB=brosan_accounting_db
DATABASE_URL="postgresql://postgres:BrosanTekstil2026SecurePass!@postgres:5432/brosan_accounting_db?schema=public"

# CORS Güvenlik Ayarları (Virgülle ayrılmış izinli kaynaklar)
CORS_ORIGIN=*

# Coolify FQDN (Coolify tarafından otomatik atanır veya domain girilir)
COOLIFY_FQDN=https://brosangroup.com/muhasebe
